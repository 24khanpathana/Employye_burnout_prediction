generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  ADMIN
  EMPLOYEE
}

enum EmployeeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TestStatus {
  DRAFT
  SCHEDULED
  LIVE
  STOPPED
  EXPIRED
  COMPLETED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum SentimentLabel {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

model Admin {
  id           String   @id @default(uuid())
  adminId      String   @unique
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Employee {
  id                    String               @id @default(uuid())
  employeeId            String               @unique
  fullName              String
  email                 String               @unique
  passwordHash          String
  position              String
  department            String
  gender                String?
  age                   Int?
  educationLevel        String?
  joiningDate           DateTime?
  countryCode           String?
  country               String?
  phoneNumber           String?
  monthlySalary         Float?
  status                EmployeeStatus       @default(PENDING)
  burnoutRisk           RiskLevel?
  attritionRisk         RiskLevel?
  burnoutScore          Float?
  attritionProbability  Float?
  retentionProbability  Float?
  averageSentimentScore Float?
  attendancePercentage  Float?
  performanceRating     Float?
  lastLogin             DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  registrationRequest   RegistrationRequest?
  tasksAssigned         Task[]               @relation("AssignedTasks")
  tasksCreated          Task[]               @relation("CreatedTasks")
  attendance            Attendance[]
  notifications         Notification[]
  predictions           Prediction[]
  testSubmissions       TestSubmission[]
  sentimentResults      SentimentResult[]
}

model RegistrationRequest {
  id              String         @id @default(uuid())
  employeeId      String         @unique
  fullName        String
  email           String
  position        String
  department      String
  passwordHash    String
  status          EmployeeStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime       @default(now())
  processedAt     DateTime?
  employee        Employee?      @relation(fields: [employeeId], references: [employeeId])
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Test {
  id               String           @id @default(uuid())
  title            String
  description      String?
  instructions     String?
  startAt          DateTime?
  expiresAt        DateTime?
  status           TestStatus       @default(DRAFT)
  resultVisibility Boolean          @default(false)
  createdBy        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  questions        TestQuestion[]
  submissions      TestSubmission[]
}

model TestQuestion {
  id            String   @id @default(uuid())
  testId        String
  questionType  String // MCQ, RATING, TEXT
  prompt        String
  options       Json?
  correctAnswer String?
  ratingMax     Int?
  createdAt     DateTime @default(now())
  test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model TestSubmission {
  id              String           @id @default(uuid())
  employeeId      String
  testId          String
  answers         Json
  submissionDate  DateTime         @default(now())
  durationMinutes Int?
  mcqScore        Float?
  ratingAverage   Float?
  sentimentScore  Float?
  sentimentLabel  SentimentLabel?
  overallScore    Float?
  createdAt       DateTime         @default(now())
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  test            Test             @relation(fields: [testId], references: [id], onDelete: Cascade)
  sentimentResult SentimentResult?
}

model SentimentResult {
  id                    String         @id @default(uuid())
  employeeId            String
  testSubmissionId      String         @unique
  averageSentimentScore Float
  overallSentimentLabel SentimentLabel
  createdAt             DateTime       @default(now())
  employee              Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  testSubmission        TestSubmission @relation(fields: [testSubmissionId], references: [id], onDelete: Cascade)
}

model Prediction {
  id                   String    @id @default(uuid())
  employeeId           String
  burnoutRisk          RiskLevel
  burnoutProbability   Float
  attritionRisk        RiskLevel
  attritionProbability Float
  retentionProbability Float
  modelVersion         String?
  createdAt            DateTime  @default(now())
  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Task {
  id           String     @id @default(uuid())
  title        String
  description  String?
  assignedById String
  assignedToId String
  dueDate      DateTime?
  priority     String     @default("MEDIUM")
  status       TaskStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assignedBy   Employee   @relation("CreatedTasks", fields: [assignedById], references: [id], onDelete: Cascade)
  assignedTo   Employee   @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: Cascade)
}

model Attendance {
  id         String           @id @default(uuid())
  employeeId String
  date       DateTime
  status     AttendanceStatus
  createdAt  DateTime         @default(now())
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Notification {
  id         String    @id @default(uuid())
  employeeId String?
  type       String
  message    String
  read       Boolean   @default(false)
  createdAt  DateTime  @default(now())
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model PasswordResetOtp {
  id        String   @id @default(uuid())
  email     String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model UploadedDataset {
  id          String   @id @default(uuid())
  source      String
  sourceUrl   String?
  fileName    String?
  rowCount    Int?
  columnCount Int?
  importDate  DateTime @default(now())
  status      String   @default("PENDING")
  metadata    Json?
}
